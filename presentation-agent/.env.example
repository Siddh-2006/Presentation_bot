# ── LLM Providers ───────────────────────────────────────────────
# Groq — primary fast LLM + Whisper STT (free tier: ~14,400 req/day)
GROQ_API_KEY=

# Google AI Studio — Gemini 2.5 Flash for deep reasoning (free tier)
GEMINI_API_KEY=

# Deepgram — fallback STT provider (free tier: 200hrs/year)
DEEPGRAM_API_KEY=

# Cerebras — ultra-fast inference fallback (free tier)
CEREBRAS_API_KEY=

# ── Session State (Upstash Redis) ────────────────────────────────
# Upstash free tier: 10,000 commands/day, sub-10ms latency
UPSTASH_REDIS_URL=
UPSTASH_REDIS_TOKEN=

# ── Slide Persistence (Supabase) ────────────────────────────────
# Supabase free tier: 500MB DB, 1GB storage
SUPABASE_URL=
SUPABASE_KEY=
